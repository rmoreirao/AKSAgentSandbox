#!/usr/bin/env bash
set -euo pipefail

operation="${1:-}"
protocol=
host=
path=
while IFS='=' read -r key value; do
  case "${key}" in
    protocol) protocol="${value}" ;;
    host) host="${value}" ;;
    path) path="${value}" ;;
  esac
done

[[ "${operation}" == "get" ]] || exit 0
[[ "${protocol}" == "https" ]] || exit 0
[[ "${host}" == "github.com" ]] || exit 0

primary_org="${DEVSANDBOX_PRIMARY_GITHUB_ORG:-}"
owner="${path%%/*}"
[[ -n "${primary_org}" && "${owner,,}" == "${primary_org,,}" ]] || exit 0

token_file="${DEVSANDBOX_GITHUB_TOKEN_FILE:-/run/devsandbox/github-token}"
[[ -r "${token_file}" ]] || exit 0
printf 'username=x-access-token\npassword='
cat "${token_file}"
printf '\n'
